{
  "manifest_version": 3,
  "name": "Clockify to GitLab /spend Copier & Syncer",
  "version": "1.1.0",
  "description": "Copy Clockify time entries as GitLab /spend commands or sync directly to GitLab API.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.clockify.me/*",
    "https://clockify.me/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.clockify.me/*",
        "https://clockify.me/*"
      ],
      "js": ["i18n.js", "config.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
